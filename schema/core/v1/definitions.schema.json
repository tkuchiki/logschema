{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tkuchiki.github.io/logschema/schema/core/v1/definitions.schema.json",
  "title": "LogSchema core definitions v1",
  "$defs": {
    "signedDecimal": {
      "description": "A canonical base-10 string representing a signed 64-bit integer.",
      "type": "string",
      "pattern": "^(?:0|(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)|-(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7]|9223372036854775808))$"
    },
    "unsignedDecimal": {
      "description": "A canonical base-10 string representing an unsigned 64-bit integer.",
      "type": "string",
      "pattern": "^(?:0|(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615))$"
    },
    "nullableSignedDecimal": {
      "description": "A signed decimal value, or null when the value is unavailable.",
      "oneOf": [
        { "$ref": "#/$defs/signedDecimal" },
        { "type": "null" }
      ]
    },
    "nullableUnsignedDecimal": {
      "description": "An unsigned decimal value, or null when the value is unavailable.",
      "oneOf": [
        { "$ref": "#/$defs/unsignedDecimal" },
        { "type": "null" }
      ]
    },
    "positiveUnsignedDecimal": {
      "description": "A canonical base-10 string representing an unsigned 64-bit integer greater than zero.",
      "allOf": [
        { "$ref": "#/$defs/unsignedDecimal" },
        { "not": { "const": "0" } }
      ]
    },
    "attributeScalar": {
      "description": "A scalar attribute value.",
      "type": ["string", "number", "integer", "boolean"]
    },
    "attributeValue": {
      "description": "A scalar or scalar array attribute value.",
      "oneOf": [
        { "$ref": "#/$defs/attributeScalar" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/attributeScalar" }
        }
      ]
    },
    "attributes": {
      "description": "Producer-defined attributes. Null values and nested objects are not allowed.",
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/attributeValue" }
    },
    "source": {
      "description": "The input source and optional location range from which the record was parsed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "description": "The kind of input source.",
          "type": "string",
          "enum": ["file", "stdin", "otlp_file", "other"]
        },
        "name": {
          "description": "A human-readable source name, such as a file path or stream name.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "fingerprint": {
          "description": "A producer-defined stable identity for the source content.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "offset_start": {
          "description": "The inclusive zero-based byte offset at which the source record starts.",
          "oneOf": [
            { "$ref": "#/$defs/unsignedDecimal" },
            { "type": "null" }
          ]
        },
        "offset_end": {
          "description": "The exclusive zero-based byte offset at which the source record ends.",
          "oneOf": [
            { "$ref": "#/$defs/unsignedDecimal" },
            { "type": "null" }
          ]
        },
        "line_start": {
          "description": "The inclusive one-based line number at which the source record starts.",
          "oneOf": [
            { "$ref": "#/$defs/positiveUnsignedDecimal" },
            { "type": "null" }
          ]
        },
        "line_end": {
          "description": "The inclusive one-based line number at which the source record ends.",
          "oneOf": [
            { "$ref": "#/$defs/positiveUnsignedDecimal" },
            { "type": "null" }
          ]
        }
      }
    },
    "resource": {
      "description": "The entity that produced the log record.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service_name": {
          "description": "The logical service name associated with the record.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "attributes": {
          "description": "Resource-level attributes.",
          "$ref": "#/$defs/attributes"
        }
      }
    },
    "traceContext": {
      "description": "Trace correlation identifiers associated with the log record.",
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id"],
      "properties": {
        "trace_id": {
          "description": "A non-zero lowercase W3C trace identifier.",
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "not": { "const": "00000000000000000000000000000000" }
        },
        "span_id": {
          "description": "A non-zero lowercase W3C span identifier when span correlation is available.",
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{16}$",
          "not": { "const": "0000000000000000" }
        },
        "trace_flags": {
          "description": "The W3C trace flags byte when available.",
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "nullableTraceContext": {
      "description": "Trace correlation context, or null when none is available.",
      "oneOf": [
        { "$ref": "#/$defs/traceContext" },
        { "type": "null" }
      ]
    }
  }
}
